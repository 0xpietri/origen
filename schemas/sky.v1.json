              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "description": "Events inside the window, sorted by time. Rise and set: upper limb on a sea-level horizon with 34 arcminutes of refraction (az_deg); transit: upper meridian transit (alt_deg); twilights: the Sun's centre at -6, -12 and -18 degrees (az_deg).",
      "items": {
