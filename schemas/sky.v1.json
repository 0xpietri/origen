{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://origen.pietri.dev/schemas/sky.v1.json",
  "title": "origen /v1/sky",
  "description": "The sky over one place, sampled over a window. Column-oriented: index i of every per-sample array is the instant times[i]. Instants are UTC to the second. Mars to Pluto are their system barycentres.",
  "type": "object",
  "required": [
    "schema",
    "engine",
    "observer",
    "from",
    "step_min",
    "count",
    "times",
    "bodies",
    "moon_phase",
    "events",
    "stars_rotation"
  ],
  "properties": {
    "schema": {
      "const": "origen.sky.v1"
    },
    "engine": {
      "$ref": "#/$defs/engine"
    },
    "observer": {
      "type": "object",
      "required": [
        "lat_deg",
        "lon_deg",
        "elev_m"
      ],
      "properties": {
        "lat_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elev_m": {
          "type": "number",
          "minimum": -500,
          "maximum": 9000
        }
      },
      "additionalProperties": true
    },
    "from": {
      "$ref": "#/$defs/instant"
    },
    "step_min": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2017
    },
    "times": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/instant"
      }
    },
    "bodies": {
      "type": "object",
      "required": [
        "sun",
        "moon",
        "mercury",
        "venus",
        "mars",
        "jupiter",
        "saturn",
        "uranus",
        "neptune",
        "pluto"
      ],
      "properties": {
        "sun": {
          "type": "object",
          "required": [
            "alt_deg",
            "az_deg",
            "distance_km",
            "magnitude",
            "ecl_lon_deg",
            "ecl_lat_deg",
            "ecl_lon_rate_deg_day"
          ],
          "properties": {
            "alt_deg": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "description": "Topocentric apparent altitude without refraction, degrees, 4 decimals."
            },
            "az_deg": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "description": "Topocentric apparent azimuth from north through east, degrees, 4 decimals."
            },
            "distance_km": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "description": "Distance from the observer at light time, kilometres."
            },
            "magnitude": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "description": "Apparent V magnitude, 2 decimals; null where the formula has no data (Saturn beyond a 6.5 degree phase angle, Neptune before 2000 beyond 1.9 degrees)."
            },
            "ecl_lon_deg": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "description": "Apparent geocentric ecliptic longitude, ecliptic and equinox of date, degrees, 4 decimals."
            },
            "ecl_lat_deg": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "description": "Apparent geocentric ecliptic latitude, degrees, 4 decimals."
            },
            "ecl_lon_rate_deg_day": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Rate of ecl_lon_deg, degrees per day, 5 decimals. Negative: retrograde."
            }
          },
          "additionalProperties": true
        },
        "moon": {
          "type": "object",
          "required": [
            "alt_deg",
            "az_deg",
            "distance_km",
            "magnitude",
            "ecl_lon_deg",
            "ecl_lat_deg",
            "ecl_lon_rate_deg_day",
            "illuminated_fraction",
            "light_dir"
          ],
