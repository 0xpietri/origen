          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "description": "Moon's minus Sun's apparent geocentric ecliptic longitude of date, 0 new, 90 first quarter, 180 full, 270 last quarter; degrees, 4 decimals."
        },
        "next": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "description": "The next new, first quarter, full and last quarter after from, sorted by time, even beyond the window.",
